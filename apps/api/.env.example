# Copy to apps/api/.env for local development. All settings use the AXIOM_ prefix.
AXIOM_ENVIRONMENT=development
AXIOM_DATABASE_URL=sqlite:///./axiom.db
# Postgres with RLS (app role) + owner role for migrations:
# AXIOM_DATABASE_URL=postgresql+psycopg://axiom_app:axiom_app@localhost/axiom
# AXIOM_MIGRATION_DATABASE_URL=postgresql+psycopg://axiom_owner:axiom_owner@localhost/axiom
# AXIOM_DB_APP_ROLE=axiom_app
AXIOM_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
AXIOM_STORAGE_BACKEND=local
AXIOM_STORAGE_PATH=./storage
# AXIOM_STORAGE_ENCRYPTION_KEY=<base64 32 bytes>   # defaults to a key derived from SECRET_KEY
# AXIOM_STORAGE_BACKEND=s3 / AXIOM_S3_BUCKET=... / AXIOM_S3_ENDPOINT_URL=... (server-side encryption)
AXIOM_AI_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=sk-ant-...   # enables AI extraction + analyst; rule-based fallback otherwise
# AXIOM_BILLING_MODE=stripe
# AXIOM_STRIPE_SECRET_KEY=sk_live_...
# AXIOM_STRIPE_PRICE_IDS={"professional":"price_...","enterprise":"price_..."}
